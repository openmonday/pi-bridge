{
  "name": "pi-bridge",
  "version": "0.1.0",
  "description": "Display-only bilingual translation for the pi coding agent",
  "keywords": ["pi-package", "translation", "bilingual"],
  "repository": { "type": "git", "url": "git+https://github.com/openmonday/pi-bridge.git" },
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "files": ["src/", "macos/", "README.md"],
  "pi": { "extensions": ["./src/index.ts"] },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "marked": "^18.0.0" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
